"""Run in a separate FreeCAD GUI process; result path is supplied by the harness."""
import os, sys, traceback, tempfile, math
repo = os.environ['FREECAD_MCP_TEST_REPO']
status = os.environ['FREECAD_MCP_TEST_STATUS']
sys.path.insert(0,os.path.join(repo,'freecad_addon'))
try:
    import FreeCAD as App
    from handlers.document import create_document, create_primitive
    from handlers.modeling import boolean_solids, transformed_copy, create_helical_ridge
    from handlers.files import save_document_copy, open_document, export_objects
    create_document('MCPModelingSmoke')
    doc=App.ActiveDocument
    box=create_primitive('box',length=20,width=20,height=20)['name']
    cyl=create_primitive('cylinder',radius=4,height=25)['name']
    moved=transformed_copy(cyl,[10,10,0],[0,0,1],0)['name']
    cut=boolean_solids('cut',box,moved)['name']
    assert 0 < doc.getObject(cut).Shape.Volume < 8000
    ridge=create_helical_ridge(5,6,2.2,8.8,1.8,0.4)['name']
    assert doc.getObject(ridge).Shape.isValid() and len(doc.getObject(ridge).Shape.Solids)==1
    before=len(doc.Objects)
    doc.openTransaction('Existing GUI action')
    doc.getObject(box).Label='Pending GUI edit'
    try:
        try:
            transformed_copy(cyl,[0,0,0],[0,0,1])
            raise AssertionError('active GUI transaction was accepted')
        except RuntimeError:
            assert App.getActiveTransaction() is not None and len(doc.Objects)==before
    finally:
        doc.abortTransaction()
    for kwargs in [dict(root_radius=5,outer_radius=4,pitch=2,height=4,root_width=1,crest_width=.5),
                   dict(root_radius=5,outer_radius=6,pitch=2,height=100,root_width=1,crest_width=.5)]:
        try: create_helical_ridge(**kwargs); raise AssertionError('invalid helix accepted')
        except ValueError: pass
    with tempfile.TemporaryDirectory() as folder:
        fc=os.path.join(folder,'part.FCStd')
        stl=os.path.join(folder,'part.stl')
        step=os.path.join(folder,'part.step')
        assert save_document_copy(fc)['bytes']>0
        assert not doc.FileName, 'saving a copy changed the original document path'
        assert export_objects(stl,[cut])['bytes']>0
        assert export_objects(step,[cut,ridge])['bytes']>0
        try: export_objects(stl,[cut]); raise AssertionError('overwrite accepted')
        except FileExistsError: pass
        opened=open_document(fc)
        assert App.getDocument(opened['name']).getObject(cut) is not None
        try: open_document(fc); raise AssertionError('duplicate open accepted')
        except ValueError: pass
        App.closeDocument(opened['name'])
    with open(status,'w') as f:f.write('OK')
except Exception:
    with open(status,'w') as f:f.write(traceback.format_exc())
finally:
    try:
        for d in list(App.listDocuments()): App.closeDocument(d)
    finally:
        from PySide import QtCore
        QtCore.QTimer.singleShot(0,Gui.getMainWindow().close)
